<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemDefinitionGroup>
    <ClCompile>
      <AdditionalIncludeDirectories>$(ProjectDir)..\Sources;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>

    <Link>
      <AdditionalLibraryDirectories>$(SolutionDir)Output\$(Platform)\$(Configuration);%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
    </Link>
  </ItemDefinitionGroup>

  <Target Name="DebugProps" BeforeTargets="Build">
    <Message Text="&gt;&gt;&gt;&gt;──────────────────────────────────────────" Importance="high"  />
    <Message Text="MSBuildProjectName: $(MSBuildProjectName)" Importance="high"  />
    <Message Text="ConfigurationType: $(ConfigurationType)" Importance="high"  />
    <Message Text="ProjectDir: $(ProjectDir)" Importance="high"  />
    <Message Text="ProjectName: $(ProjectName)" Importance="high"  />
  </Target>

</Project>