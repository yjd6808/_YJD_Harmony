<Window x:Class="SGToolsResearch.RTBLogViewerResearchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:common_ctrl="clr-namespace:SGToolsCommon.Customize.Control;assembly=SGToolsCommon"
        mc:Ignorable="d"
        Title="01. RTBLogViewer Research"
        Width="900"
        Height="600">
    <Grid>
        <common_ctrl:RTBLogViewer x:Name="logViewer_"
                                  Background="Black"
                                  Foreground="White"
                                  FontSize="13"
                                  FontFamily="Consolas"
                                  BorderThickness="0"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Auto"/>
    </Grid>
</Window>
