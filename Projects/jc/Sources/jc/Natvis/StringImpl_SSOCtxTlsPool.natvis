<?xml version="1.0" encoding="utf-8"?>
<AutoVisualizer xmlns="http://schemas.microsoft.com/vstudio/debugger/natvis/2010">

	<!--
	작성자: 윤정도
	작성일: 9/6/2026

	StringImpl_SSOCtxTlsPool<CharT> (PooledString의 Storage) 시각화.
	pCtx_ == nullptr이면 빈 문자열. 아니면 슬롯의 SSO/힙 버퍼를 보여준다.
	-->

	<Type Name="jc::StringSlot&lt;char&gt;">
		<DisplayString Condition="pHeap_==0">{sso_,s8}</DisplayString>
		<DisplayString Condition="pHeap_!=0">{pHeap_,s8}</DisplayString>
		<StringView Condition="pHeap_==0">sso_,na</StringView>
		<StringView Condition="pHeap_!=0">pHeap_,na</StringView>
		<Expand>
			<Item Name="[poolIdx_]">poolIdx_</Item>
			<Item Name="[len_]">len_</Item>
			<Item Name="[cap_]">cap_</Item>
			<Item Name="[heap_]">pHeap_!=0</Item>
		</Expand>
	</Type>

	<Type Name="jc::StringSlot&lt;wchar_t&gt;">
		<DisplayString Condition="pHeap_==0">{sso_,su}</DisplayString>
		<DisplayString Condition="pHeap_!=0">{pHeap_,su}</DisplayString>
		<StringView Condition="pHeap_==0">sso_,na</StringView>
		<StringView Condition="pHeap_!=0">pHeap_,na</StringView>
		<Expand>
			<Item Name="[poolIdx_]">poolIdx_</Item>
			<Item Name="[len_]">len_</Item>
			<Item Name="[cap_]">cap_</Item>
			<Item Name="[heap_]">pHeap_!=0</Item>
		</Expand>
	</Type>

	<Type Name="jc::StringImpl_SSOCtxTlsPool&lt;char&gt;">
		<DisplayString Condition="pCtx_==0">""</DisplayString>
		<DisplayString Condition="pCtx_!=0 &amp;&amp; pCtx_-&gt;pHeap_==0">{pCtx_-&gt;sso_,s8}</DisplayString>
		<DisplayString Condition="pCtx_!=0 &amp;&amp; pCtx_-&gt;pHeap_!=0">{pCtx_-&gt;pHeap_,s8}</DisplayString>
		<Expand>
			<Item Name="[ctx_]">pCtx_</Item>
		</Expand>
	</Type>

	<Type Name="jc::StringImpl_SSOCtxTlsPool&lt;wchar_t&gt;">
		<DisplayString Condition="pCtx_==0">""</DisplayString>
		<DisplayString Condition="pCtx_!=0 &amp;&amp; pCtx_-&gt;pHeap_==0">{pCtx_-&gt;sso_,su}</DisplayString>
		<DisplayString Condition="pCtx_!=0 &amp;&amp; pCtx_-&gt;pHeap_!=0">{pCtx_-&gt;pHeap_,su}</DisplayString>
		<Expand>
			<Item Name="[ctx_]">pCtx_</Item>
		</Expand>
	</Type>

</AutoVisualizer>
