<UserControl x:Class="SGToolsCommon.Customize.Control.TextBoxGeneratorDataGrid"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SGToolsCommon.Customize.Control"
             mc:Ignorable="d" 
             x:Name="ControlMain"
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <Style TargetType="DataGridCell">
            <!-- DataGrid 셀 테두리 제거 -->
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <DataTemplate x:Key="DefaultTextBoxTemplate1" DataType="{x:Type local:InternalDataGridItem}">
            <local:AutoCompleteTextBox Text="{Binding Text1, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                       Candidates="{Binding Path=Candidates1, ElementName=ControlMain}" 
                                       TextChanged="AutoCompleteTextBox1_OnTextChanged"
                                       x:Name="Dx">
                <local:AutoCompleteTextBox.Placeholder>
                    <MultiBinding Converter="{StaticResource StringConcatConverter}"
                                  UpdateSourceTrigger="PropertyChanged">
                        <Binding Path="IndexName"/>
                        <Binding Path="PlaceholderSuffix1" RelativeSource="{RelativeSource AncestorType=local:TextBoxGeneratorDataGrid}" />
                    </MultiBinding>
                </local:AutoCompleteTextBox.Placeholder>
            </local:AutoCompleteTextBox>
        </DataTemplate>

        <DataTemplate x:Key="DefaultTextBoxTemplate2" DataType="{x:Type local:InternalDataGridItem}">
            <local:AutoCompleteTextBox Text="{Binding Text2, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                       Candidates="{Binding Path=Candidates2, RelativeSource={RelativeSource AncestorType=local:TextBoxGeneratorDataGrid}}" 
                                       TextChanged="AutoCompleteTextBox2_OnTextChanged"
                                       Placeholder="{Binding Path=PlaceholderSuffix2, RelativeSource={RelativeSource AncestorType=local:TextBoxGeneratorDataGrid}}"
                                       x:Name="Dz">
            </local:AutoCompleteTextBox>
        </DataTemplate>

        <DataTemplate x:Key="DefaultComboBoxTemplate1" DataType="{x:Type local:InternalDataGridItem}">
            <ComboBox ItemsSource="{Binding ComboBoxItems1, ElementName=ControlMain}"
                      SelectedIndex="{Binding ComboBoxIndex1, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                      SelectionChanged="ComboBox1_OnSelectionChanged"/>
        </DataTemplate>

        <!-- 안쓰임 -->
        <DataTemplate x:Key="DefaultComboBoxTemplate2" DataType="{x:Type local:InternalDataGridItem}">
            <ComboBox ItemsSource="{Binding ComboBoxItems2, ElementName=ControlMain}"
                      SelectionChanged="ComboBox2_OnSelectionChanged"/>
        </DataTemplate>

        <DataTemplate x:Key="DefaultAddButtonTemplate" DataType="{x:Type local:InternalDataGridItem}">
            <Button Content="+" BorderThickness="0" Click="ClickAddItem">
                <Button.Style>
                    <Style TargetType="Button">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsLastItem}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsLastItem}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding VM.CanAdd, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="False">
                                <Setter Property="IsEnabled" Value="False"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding VM.CanAdd, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                <Setter Property="IsEnabled" Value="True"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </DataTemplate>

        <DataTemplate x:Key="DefaultMinusButtonTemplate" DataType="{x:Type local:InternalDataGridItem}">
            <Button Content="-" BorderThickness="0" Click="ClickRemoveItem">
                <Button.Style>
                    <Style TargetType="Button">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsFirstItem}" Value="True">
                                <Setter Property="IsEnabled" Value="False"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsFirstItem}" Value="False">
                                <Setter Property="IsEnabled" Value="True"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </DataTemplate>
    </UserControl.Resources>
    <Grid>
        <!--데이타그리스 선택 효과 제거 @참고: https://stackoverflow.com/questions/2496814/disable-selecting-in-wpf-datagrid-->
        <DataGrid x:Name="ItemsDataGrid" 
                  HeadersVisibility="None" 
                  GridLinesVisibility="None"
                  AutoGenerateColumns="False" 
                  BorderThickness="0"
                  HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Stretch"
                  VerticalScrollBarVisibility="Hidden"
                  HorizontalScrollBarVisibility="Hidden"
                  SelectionUnit="FullRow"
                  SelectionMode="Single"
                  RowBackground="Transparent"
                  RowHeight="{Binding RowHeight, ElementName=ControlMain}"
                  Background="{Binding Background, ElementName=ControlMain}"
                  ItemsSource="{Binding Items, ElementName=ControlMain}"
                  KeyboardNavigation.TabNavigation="None"
                  CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridTemplateColumn x:Name="TemplateColumn0"
                                        CellTemplate="{StaticResource DefaultComboBoxTemplate1}"/>
                <DataGridTemplateColumn x:Name="TemplateColumn1"
                                        CellTemplate="{StaticResource DefaultTextBoxTemplate1}"/>
                <DataGridTemplateColumn x:Name="TemplateColumn2"
                                        CellTemplate="{StaticResource DefaultTextBoxTemplate2}">
                </DataGridTemplateColumn>
                <DataGridTemplateColumn x:Name="TemplateColumn3"
                                        CellTemplate="{StaticResource DefaultAddButtonTemplate}">
                    <DataGridTemplateColumn.CellStyle>
                        <Style TargetType="{x:Type DataGridCell}">
                            <EventSetter Event="Loaded" Handler="ButtonAddCellLoaded" />
                        </Style>
                    </DataGridTemplateColumn.CellStyle>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn x:Name="TemplateColumn4"
                                        CellTemplate="{StaticResource DefaultMinusButtonTemplate}">
                    <DataGridTemplateColumn.CellStyle>
                        <Style TargetType="{x:Type DataGridCell}">
                            <EventSetter Event="Loaded" Handler="ButtonMinusCellLoaded" />
                        </Style>
                    </DataGridTemplateColumn.CellStyle>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
            <DataGrid.CellStyle>
                <Style TargetType="DataGridCell">
                    <EventSetter Event="Loaded" Handler="DataGridCell_Loaded" />
                </Style>
            </DataGrid.CellStyle>
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <EventSetter Event="Loaded" Handler="DataGridRow_Loaded" />
                </Style>
            </DataGrid.RowStyle>

        </DataGrid>
    </Grid>
</UserControl>
