<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:SGToolsCommon.Customize.Control">

    <!-- PlaceholderTextBox Style -->
    <Style BasedOn="{StaticResource {x:Type TextBox}}" TargetType="{x:Type local:PlaceholderTextBox}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:PlaceholderTextBox}">
                    <Grid>
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <!-- 부모 컨트롤 템플릿에서 해당 타겟을 정의하고 있음 -->
                            <ScrollViewer x:Name="PART_ContentHost" />
                        </Border>

                        <!--Border의 Background 색상이 TextBlock을 가리면 안되므로 Border속성보다 앞에 배치하도록 하쟈-->
                        <TextBlock Name="PART_PlaceholderTextBlock"
                                   Margin="4, 0, 0, 0"
                                   Foreground="Gray"
                                   VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                   IsHitTestVisible="False"
                                   Text="{TemplateBinding Placeholder}">
                        </TextBlock>

                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEmpty"
                                 Value="False">
                            <Setter TargetName="PART_PlaceholderTextBlock"
                                    Property="Visibility"
                                    Value="Hidden" />
                        </Trigger>
                        <Trigger Property="IsEmpty"
                                 Value="True">
                            <Setter TargetName="PART_PlaceholderTextBlock"
                                    Property="Visibility"
                                    Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ImageToggleButton Style -->
    <Style TargetType="local:ImageToggleButton">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:ImageToggleButton">
                    <Grid>
                        <Image Width="{TemplateBinding Width}"
                               Height="{TemplateBinding Height}"
                               Source="{Binding Path=CurrentImageSource, 
                                        RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:ImageToggleButton}}}">
                        </Image>
                        <ContentPresenter Content="{Binding Path=Content, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:ImageToggleButton}}}">
                        </ContentPresenter>
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver"
                                             Value="True">
                                        <Setter Property="Background"
                                                Value="LightSkyBlue" />
                                    </Trigger>
                                    <Trigger Property="IsEnabled"
                                             Value="False">
                                        <Setter Property="Opacity"
                                                Value="0.4"></Setter>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                    </Grid>

                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
